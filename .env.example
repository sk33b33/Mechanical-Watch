# Optional. Powers the tutorial's narration with real Microsoft edge-tts voices via a Supabase
# Edge Function proxy (see supabase/functions/tts-proxy/README.md for setup). If unset, the
# tutorial falls back to the browser's own built-in speech synthesis automatically — the app
# works fine without these.
VITE_SUPABASE_TTS_URL=
VITE_SUPABASE_TTS_ANON_KEY=
